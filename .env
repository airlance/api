# App
APP_ENV=development
LOG_LEVEL=info

# TCP server
SERVER_ADDR=:8080
SERVER_KEY_PATH=./server-key.json
SERVER_HEARTBEAT_TIMEOUT=60s

# HTTP server (GitHub OAuth callback)
HTTP_ADDR=:8081

# Database
DB_DSN=postgres://airlance:airlance@postgres:5432/airlance?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Node identity (persistent UUID file; auto-generated on first start)
NODE_ID_PATH=./data/node_id

# GitHub OAuth
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_REDIRECT_URI=https://api.localhost/auth/github/callback
GITHUB_HMAC_SECRET=change-me-in-production
APP_CALLBACK_URL=airlance://auth/callback

# SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@airlance.app