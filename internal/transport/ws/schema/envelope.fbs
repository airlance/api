// WebSocket Application Protocol Schema

namespace airlance.ws;

enum ErrorCode: ubyte {
    INVALID_REQUEST = 0,
    UNAUTHENTICATED = 1,
    PERMISSION_DENIED = 2,
    NOT_FOUND = 3,
    CONFLICT = 4,
    RATE_LIMITED = 5,
    UNSUPPORTED_PROTOCOL = 6,
    INTERNAL = 7,
    SERVICE_UNAVAILABLE = 8
}

table Error {
    code: ErrorCode;
    message: string;
    retryable: bool;
    retry_after_ms: uint;
}

table Ping {
    timestamp: ulong;
}

table Pong {
    timestamp: ulong;
}

table Empty {}

table TestEcho {
    data: string;
}

table OtpLinkEmailRequest {
    email: string;
}

table OtpLinkEmailAck {
    request_id: string;
    expires_at_ms: ulong; // unix millis
}

table OtpLinkEmailVerify {
    request_id: string;
    code: string;
}

table OtpLinkEmailVerified {
    identity_id: string;
    email: string;
    linked_at_ms: ulong;
}

table SessionListRequest {}

table SessionInfo {
    session_id: string;
    device_id: string;   // empty if session has no device
    platform: string;    // empty if unknown
    ip: string;
    created_at_ms: ulong;
    expires_at_ms: ulong;
    is_current: bool;    // true for the session opening this socket
}

table SessionListResponse {
    sessions: [SessionInfo];
}

table LogoutRequest {}

table LogoutResponse {
    session_id: string;
}

table UserProfileRequest {}

table UserProfileResponse {
    user_id: string;
    session_id: string;
    device_id: string;
}

table SessionRevokeRequest {
    session_id: string;
}

table SessionRevokeResponse {
    session_id: string;
}

table SessionRevokeAllRequest {}

table SessionRevokeAllResponse {
    status: string;
}

table DeviceInfo {
    device_id: string;
    platform: string;
    created_at_ms: ulong;
    last_seen_at_ms: ulong;
    last_app_version: string;
    revoked_at_ms: ulong;
    is_current: bool;
}

table DeviceListRequest {}

table DeviceListResponse {
    devices: [DeviceInfo];
}

table DeviceRevokeRequest {
    device_id: string;
}

table DeviceRevokeResponse {
    device_id: string;
}

table PasskeyInfo {
    id: string;
    aaguid: string;
    transports: [string];
    created_at_ms: ulong;
    last_used_at_ms: ulong;
}

table PasskeyListRequest {}

table PasskeyListResponse {
    credentials: [PasskeyInfo];
}

table PasskeyRegisterOptionsRequest {}

table PasskeyRegisterOptionsResponse {
    challenge_id: string;
    options_json: string;
}

table PasskeyRegisterVerifyRequest {
    challenge_id: string;
    response_json: string;
}

table PasskeyRegisterVerifyResponse {
    id: string;
    created_at_ms: ulong;
}

table PasskeyDeleteRequest {
    id: string;
}

table PasskeyDeleteResponse {
    id: string;
}

union Payload {
    Ping,
    Pong,
    Error,
    Empty,
    TestEcho,
    OtpLinkEmailRequest,
    OtpLinkEmailAck,
    OtpLinkEmailVerify,
    OtpLinkEmailVerified,
    SessionListRequest,
    SessionListResponse,
    LogoutRequest,
    LogoutResponse,
    UserProfileRequest,
    UserProfileResponse,
    SessionRevokeRequest,
    SessionRevokeResponse,
    SessionRevokeAllRequest,
    SessionRevokeAllResponse,
    DeviceListRequest,
    DeviceListResponse,
    DeviceRevokeRequest,
    DeviceRevokeResponse,
    PasskeyListRequest,
    PasskeyListResponse,
    PasskeyRegisterOptionsRequest,
    PasskeyRegisterOptionsResponse,
    PasskeyRegisterVerifyRequest,
    PasskeyRegisterVerifyResponse,
    PasskeyDeleteRequest,
    PasskeyDeleteResponse
}

table Envelope {
    protocol_version: uint;
    client_version: uint;
    message_id: ulong;
    correlation_id: ulong;
    payload: Payload;
}

root_type Envelope;
