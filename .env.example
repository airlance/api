# Local development only. Do not use these values in production.
APP_ENV=development
PORT=8080
SERVICE_NAME=airlance-api

# Matches the postgres and redis services in docker-compose.yml.
DATABASE_URL=postgres://postgres:password@localhost:5432/airlance?sslmode=disable
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=debug
LOG_FORMAT=console

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=Airlance
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_WS_ORIGINS=http://localhost:3000,http://localhost:8080

# Plain HTTP is permitted only for the local development environment.
REQUIRE_TLS=false

# CIDRs that may scrape /metrics. Production must list the monitoring network.
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
